    {
      "type": "core:encode-video",
      "version": 2,
      "kind": "action",
      "title": "Encode video",
      "description": "Re-encodes the video stream.",
      "icon": "video",
      "inputs": [
        {
          "id": "file",
          "label": "File",
          "type": "file"
        }
      ],
      "outputs": [
        {
          "id": "file",
          "label": "File",
          "type": "file"
        }
      ],
      "settingsSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "codec": {
            "default": "hevc",
            "description": "Target codec",
            "type": "string",
            "enum": [
              "hevc",
              "h264",
              "av1"
            ]
          },
          "encoder": {
            "default": "auto",
            "description": "Encoder (auto picks hardware first)",
            "type": "string"
          },
          "rateControl": {
            "default": "quality",
            "description": "Rate control; quality keeps a constant quality (CRF, or CQ/QP on hardware), bitrate aims at the target bitrate",
            "type": "string",
            "enum": [
              "quality",
              "bitrate"
            ]
          },
          "quality": {
            "default": 24,
            "description": "Quality (CRF); lower is better",
            "x-transcoda-show-when": {
              "rateControl": "quality"
            },
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "bitrateKbps": {
            "default": 6000,
            "description": "Target bitrate (kb/s)",
            "x-transcoda-show-when": {
              "rateControl": "bitrate"
            },
            "type": "integer",
            "minimum": 100,
            "maximum": 200000
          },
          "neverIncreaseBitrate": {
            "default": true,
            "description": "Never above the source bitrate; caps the encode at the source video's bitrate (the whole file's when the stream has none)",
            "type": "boolean"
          },
          "preset": {
            "default": "medium",
            "description": "Encoder preset",
            "type": "string"
          },
          "skipIf": {
            "default": "already-target-codec",
            "description": "Skip encoding when",
            "type": "string",
            "enum": [
              "never",
              "already-target-codec",
              "plays-on-all-targets"
            ]
          },
          "targets": {
            "default": [],
            "description": "Target devices",
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "android-tv",
                "chrome"
              ],
              "description": "Target devices"
            }
          }
        }
      },
      "onNodeSettings": [
        "quality",
        "bitrateKbps"
      ],
      "finishPhase": null,
      "source": {
        "kind": "core"
      },
      "availability": {
        "available": true
      }
