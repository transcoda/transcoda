    {
      "type": "core:encode-audio",
      "version": 3,
      "kind": "action",
      "title": "Encode audio",
      "description": "Copies or re-encodes the audio streams.",
      "icon": "volume-2",
      "inputs": [
        {
          "id": "file",
          "label": "File",
          "type": "file"
        }
      ],
      "outputs": [
        {
          "id": "file",
          "label": "File",
          "type": "file"
        }
      ],
      "settingsSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "mode": {
            "default": "copy",
            "description": "Mode",
            "type": "string",
            "enum": [
              "copy",
              "reencode"
            ]
          },
          "codec": {
            "default": "aac",
            "description": "Codec",
            "type": "string",
            "enum": [
              "aac",
              "ac3",
              "opus"
            ]
          },
          "bitrateKbps": {
            "default": 160,
            "description": "Bitrate (kb/s)",
            "type": "integer",
            "minimum": 32,
            "maximum": 1024
          },
          "neverIncreaseBitrate": {
            "default": true,
            "description": "Never above the source bitrate; a track is encoded at most at its source bitrate, when it's known",
            "type": "boolean"
          },
          "downmixTo": {
            "default": "none",
            "description": "Downmix to",
            "type": "string",
            "enum": [
              "none",
              "stereo"
            ]
          },
          "updateTitles": {
            "default": true,
            "description": "Update track titles; a re-encoded track's title names its new format (codec, channels, bitrate) instead of the old one, and keeps its other words",
            "type": "boolean"
          },
          "targets": {
            "default": [],
            "description": "Target devices",
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "android-tv",
                "chrome"
              ],
              "description": "Target devices"
            }
          },
          "whenUnsupported": {
            "default": "add-track",
            "description": "When a target cannot play a kept track",
            "type": "string",
            "enum": [
              "add-track",
              "convert",
              "fail"
            ]
          }
        }
      },
