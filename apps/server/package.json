{
  "name": "@transcoda/server",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "scripts": {
    "dev": "pnpm build:host && TRANSCODA_CONFIG_DIR=./.local/config TRANSCODA_WEB_DIR=../web/dist TRANSCODA_PLUGIN_HOST=$PWD/.local/plugin-host/plugin-host.js tsx watch src/main.ts",
    "build:host": "tsdown --filter host --out-dir .local/plugin-host",
    "build": "tsdown",
    "start": "node dist/main.js",
    "test": "vitest run",
    "dump-nodes": "tsx scripts/dump-nodes.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@orpc/contract": "1.15.7",
    "@orpc/json-schema": "1.15.7",
    "@orpc/openapi": "1.15.7",
    "@orpc/server": "1.15.7",
    "@orpc/zod": "1.15.7",
    "@transcoda/contract": "workspace:*",
    "@transcoda/sdk": "workspace:*",
    "@transcoda/shared": "workspace:*",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.13",
    "semver": "7.8.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@orpc/client": "1.15.7",
    "@types/better-sqlite3": "9.6.0",
    "@types/semver": "7.8.0",
    "tsdown": "0.23.1",
    "tsx": "4.23.15"
  }
}
