{
  "name": "@transcoda/sdk",
  "version": "1.0.0",
  "description": "Write plugins for Transcoda: nodes, integrations and triggers that run in a sandboxed process.",
  "license": "GPL-3.0-only",
  "type": "module",
  "homepage": "https://github.com/transcoda/transcoda/blob/main/docs/plugin-sdk.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/transcoda/transcoda.git",
    "directory": "packages/sdk"
  },
  "bugs": "https://github.com/transcoda/transcoda/issues",
  "keywords": [
    "transcoda",
    "plugin",
    "sdk",
    "ffmpeg"
  ],
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "files": [
    "build",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./testing": {
        "types": "./build/testing.d.ts",
        "default": "./build/testing.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@transcoda/shared": "workspace:*"
  }
}
