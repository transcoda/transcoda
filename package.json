{
  "name": "transcoda",
  "private": true,
  "type": "module",
  "version": "0.7.0",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "test": "vitest run",
    "build": "pnpm --filter @transcoda/web build && pnpm --filter @transcoda/server build",
    "release": "node scripts/release-notes.mjs",
    "knip": "knip",
    "check-deps": "node scripts/check-deps.mjs && node --test scripts/check-deps.test.mjs",
    "fixtures": "node scripts/fixtures/generate.mjs",
    "e2e": "playwright test",
    "e2e:docker": "sh scripts/e2e-docker.sh",
    "e2e:update": "sh scripts/e2e-docker.sh --update-snapshots",
    "test:docker": "sh scripts/e2e-docker.sh --unit",
    "e2e:report": "playwright show-report .local/e2e-report",
    "notices": "node scripts/third-party-notices.ts",
    "check-licences": "node --test scripts/third-party-notices.test.ts && node scripts/third-party-notices.ts --check",
    "check": "pnpm typecheck && pnpm lint && pnpm knip && pnpm check-deps && pnpm check-licences && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "knip": "6.48.0",
    "tsdown": "0.23.7",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
