{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["@transcoda/dev-config/biome"],
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/dist-types",
      "!packages/sdk/build",
      "!**/node_modules",
      "!**/.local",
      "!**/.superpowers",
      "!docs/design",
      "!apps/web/src/styles/tokens.css",
      "!apps/web/src/test/fixtures/nodes.json",
      "!apps/web/src/assets/tmdb.svg",
      "!apps/server/src/engine/fixtures/*.json",
      "!apps/server/third-party.json",
      "!pnpm-lock.yaml"
    ]
  },
  "plugins": [
    {
      "path": "./node_modules/@transcoda/dev-config/biome/utc-dates.grit",
      "includes": ["apps/server/src/**", "packages/*/src/**", "!**/*.test.ts"]
    },
    {
      "path": "./node_modules/@transcoda/dev-config/biome/test-cleanup.grit",
      "includes": ["apps/web/src/**/*.test.tsx", "apps/web/src/**/*.test.ts"]
    }
  ],
  "overrides": [
    {
      "includes": [
        "apps/server/**",
        "packages/**",
        "scripts/**",
        "e2e/**",
        "!apps/server/src/db/migrations/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": { "filenameCases": ["kebab-case"] }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": { "filenameCases": ["kebab-case", "PascalCase"] }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/server/src/plugins/fixtures/**",
        "apps/server/src/plugins/testing/global-setup.ts"
      ],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    },
    {
      "includes": ["e2e/**"],
      "linter": { "rules": { "style": { "useConsistentTestIt": "off" } } }
    },
    {
      "includes": ["apps/server/src/platform/logger.ts"],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    },
    {
      "includes": ["apps/web/src/**/*.css"],
      "linter": { "rules": { "style": { "noHexColors": "error" } } }
    }
  ]
}
