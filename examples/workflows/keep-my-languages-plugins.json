{
  "formatVersion": 2,
  "kind": "workflow",
  "nodes": [
    {
      "id": "input",
      "type": "core:input-manual",
      "typeVersion": 1,
      "settings": {},
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "orig",
      "type": "sonarr:original-language",
      "typeVersion": 1,
      "settings": {},
      "position": {
        "x": 240,
        "y": -160
      }
    },
    {
      "id": "languages",
      "type": "core:keep-languages",
      "typeVersion": 1,
      "settings": {
        "languages": ["en"],
        "keepOriginal": true,
        "keepUntagged": true
      },
      "position": {
        "x": 240,
        "y": 0
      },
      "links": {
        "languages": "Languages"
      }
    },
    {
      "id": "duplicates",
      "type": "core:remove-duplicate-audio",
      "typeVersion": 1,
      "settings": {},
      "position": {
        "x": 480,
        "y": 0
      }
    },
    {
      "id": "defaults",
      "type": "core:set-default-track",
      "typeVersion": 1,
      "settings": {
        "audioLanguages": ["en"],
        "subtitleLanguages": ["en"]
      },
      "position": {
        "x": 720,
        "y": 0
      },
      "links": {
        "audioLanguages": "Languages",
        "subtitleLanguages": "Languages"
      }
    },
    {
      "id": "order",
      "type": "core:reorder-tracks",
      "typeVersion": 1,
      "settings": {
        "languages": ["en"]
      },
      "position": {
        "x": 960,
        "y": 0
      },
      "links": {
        "languages": "Languages"
      }
    },
    {
      "id": "extras",
      "type": "core:cover-attachments",
      "typeVersion": 1,
      "settings": {
        "keepCover": true,
        "keepAttachments": false
      },
      "position": {
        "x": 1200,
        "y": 0
      }
    },
    {
      "id": "render",
      "type": "core:render",
      "typeVersion": 1,
      "settings": {},
      "position": {
        "x": 1440,
        "y": 0
      }
    },
    {
      "id": "replace",
      "type": "core:replace-original",
      "typeVersion": 1,
      "settings": {},
      "position": {
        "x": 1680,
        "y": 0
      }
    },
    {
      "id": "rescan",
      "type": "sonarr:rescan",
      "typeVersion": 1,
      "settings": {
        "timeoutSeconds": 240
      },
      "position": {
        "x": 1920,
        "y": -160
      }
    },
    {
      "id": "refresh",
      "type": "jellyfin:refresh",
      "typeVersion": 1,
      "settings": {
        "scope": "file"
      },
      "position": {
        "x": 1920,
        "y": 0
      }
    },
    {
      "id": "notify",
      "type": "ntfy:notify",
      "typeVersion": 1,
      "settings": {
        "topic": "transcoda-CHANGE-ME",
        "events": "done"
      },
      "position": {
        "x": 1920,
        "y": 160
      }
    }
