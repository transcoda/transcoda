  "edges": [
    {
      "id": "input-languages",
      "from": {
        "node": "input",
        "port": "file"
      },
      "to": {
        "node": "languages",
        "port": "file"
      }
    },
    {
      "id": "languages-duplicates",
      "from": {
        "node": "languages",
        "port": "file"
      },
      "to": {
        "node": "duplicates",
        "port": "file"
      }
    },
    {
      "id": "duplicates-defaults",
      "from": {
        "node": "duplicates",
        "port": "file"
      },
      "to": {
        "node": "defaults",
        "port": "file"
      }
    },
    {
      "id": "defaults-order",
      "from": {
        "node": "defaults",
        "port": "file"
      },
      "to": {
        "node": "order",
        "port": "file"
      }
    },
    {
