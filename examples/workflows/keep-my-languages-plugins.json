        "node": "order",
        "port": "file"
      },
      "to": {
        "node": "extras",
        "port": "file"
      }
    },
    {
      "id": "extras-render",
      "from": {
        "node": "extras",
        "port": "file"
      },
      "to": {
        "node": "render",
        "port": "file"
      }
    },
    {
      "id": "render-replace",
      "from": {
        "node": "render",
        "port": "done"
      },
      "to": {
        "node": "replace",
        "port": "file"
      }
    },
    {
      "id": "replace-rescan",
      "from": {
        "node": "replace",
        "port": "file"
      },
      "to": {
        "node": "rescan",
        "port": "file"
      }
    },
    {
      "id": "replace-refresh",
      "from": {
        "node": "replace",
        "port": "file"
      },
      "to": {
        "node": "refresh",
        "port": "file"
      }
    },
    {
      "id": "replace-notify",
      "from": {
        "node": "replace",
        "port": "file"
      },
      "to": {
        "node": "notify",
        "port": "file"
      }
    },
    {
      "id": "orig-languages",
      "from": {
        "node": "orig",
        "port": "language"
      },
      "to": {
        "node": "languages",
        "port": "language"
      }
    }
  ],
  "groups": [
    {
      "id": "start",
      "name": "Start here",
      "collapsed": false,
      "position": {
        "x": 0,
        "y": -440
      },
      "size": {
        "width": 600,
        "height": 260
      },
      "note": "## Keep my languages, with plugins\n\n**Keep my languages**, plus your *arr apps and media server:\n\n- **Original language (Sonarr)** tells Keep languages which language the show was made in, so that track is always kept.\n- After the file is replaced, Sonarr rescans it, Jellyfin refreshes it and ntfy sends a notification.\n\nNeeds the Sonarr, Jellyfin and ntfy plugins. Change the ntfy **Topic** to a private one."
    }
  ],
  "values": {
    "position": {
      "x": 640,
      "y": -360
    },
    "entries": [
      {
        "name": "Languages",
        "schema": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([a-z]{2,3}|unknown)$"
          }
        },
        "value": ["en"]
      }
    ]
  }
}
